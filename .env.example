# Adres produkcyjny strony, bez ukośnika na końcu.
# Potrzebny do canonical, Open Graph, sitemap.xml i robots.txt.
#
# Zostaw pusty aż do podpięcia domeny — wtedy Vercel poda własny adres
# projektu (VERCEL_PROJECT_PRODUCTION_URL) i wszystko działa automatycznie.
# Po podpięciu kamieniarstwo-hermes.pl ustaw tę zmienną w
# Vercel → Settings → Environment Variables (środowisko: Production).
NEXT_PUBLIC_SITE_URL=https://kamieniarstwo-hermes.pl
